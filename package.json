{
  "name": "alemonjs-roco",
  "version": "0.0.14",
  "description": "mhy-mod",
  "author": "ningmengchongshui",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "scripts": {
    "app": "node index.js",
    "dev": "npx lvy app.ts",
    "view": "npx lvy app.ts --jsxp",
    "test:expose": "yarn build && node --test test/expose*.test.mjs",
    "lint": "eslint src --ext .ts,.tsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "axios": "^1.14.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "jsxp": "^1.4.0",
    "lvyjs-plugin-postcss": "^0.2.0",
    "markdown-to-jsx": "^9.7.13",
    "md5": "^2.3.0",
    "qrcode": "^1.5.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/xiuxianjs/alemonjs-roco/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiuxianjs/alemonjs-roco.git"
  },
  "gitHead": "9b799621b3e7a2a1589b69b1818afdaf65f3d604"
}
