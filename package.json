{
  "name": "alemonjs-roco",
  "version": "1.0.0-rc.1",
  "description": "mhy-mod",
  "author": "ningmengchongshui",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "scripts": {
    "app": "node index.js",
    "dev": "npx lvy app.ts",
    "view": "npx lvy app.ts --jsxp",
    "build": "lvy build",
    "test:expose": "yarn build && node --test test/expose*.test.mjs",
    "lint": "eslint src --ext .ts,.tsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "axios": "^1.14.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "jsxp": "^1.4.0",
    "lvyjs-plugin-postcss": "^0.2.0",
    "markdown-to-jsx": "^9.7.13",
    "md5": "^2.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@alemonjs/qq-bot": "^2.1.44",
    "@eslint/js": "^9.14.0",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-router": "^7.4.10",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "8.18.1",
    "alemonjs": "^2.1.119",
    "cssnano": "^7.0.6",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsxp": "^1.4.0",
    "lint-staged": "^16.1.5",
    "lvyjs": "^0.3.0-alpha.5",
    "prettier": "^3.5.3",
    "sass": "^1.83.0",
    "tailwindcss": "^3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.19.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/xiuxianjs/alemonjs-roco/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiuxianjs/alemonjs-roco.git"
  }
}
